[Unit]
Description=Xray exit transport for captive relay
After=network-online.target docker.service wg-captive-admin.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=/etc/wg-captive-agent.env
ExecStart=/usr/local/sbin/wg-captive-xray
Restart=on-failure
RestartSec=5
TimeoutStopSec=5
KillMode=control-group
RuntimeDirectory=wg-captive-xray
RuntimeDirectoryMode=0700
UMask=0077
