#!/usr/bin/env bash
set -euo pipefail
export PATH="/usr/local/lib/wg-captive-agent/amneziawg/bin:/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/bin:/sbin"
CONFIG_FILE="${CONFIG_FILE:-/etc/wg-captive-agent.env}"
[[ ! -f "$CONFIG_FILE" ]] || source "$CONFIG_FILE"
STATE_DB="${STATE_DB:-/etc/wg-captive-agent.db}"
AGENT_BIN="${AGENT_BIN:-/usr/local/sbin/wg-captive-agent}"
RUNTIME_DIR="${AMNEZIAWG_RUNTIME_DIR:-/run/wg-captive-amneziawg}"
RELAY_ROUTE_FLAG="${RELAY_ROUTE_FLAG:-/etc/wg-captive-relay.enabled}"
CONFIG_HELPER="${AMNEZIAWG_CONFIG_HELPER:-/usr/local/lib/wg-captive-agent/amnezia-config.js}"
[[ "$(sqlite3 -noheader "$STATE_DB" 'SELECT protocol FROM relay_config WHERE id=1;')" == amneziawg ]] || exit 1
conf="$(sqlite3 -noheader "$STATE_DB" 'SELECT amneziawg_conf_path FROM relay_config WHERE id=1;')"
[[ -s "$conf" ]] || { echo 'Import AmneziaWG config first' >&2; exit 1; }
install -d -m 0700 "$RUNTIME_DIR"
umask 077
node "$CONFIG_HELPER" "$conf" "$RUNTIME_DIR/awg-exit.conf"
target_pid=""
prefix=()
if [[ -n "${WG_EASY_CONTAINER:-}" && "$WG_EASY_CONTAINER" != host ]]; then
  target_pid="$(docker inspect -f '{{.State.Pid}}' "$WG_EASY_CONTAINER")"
  [[ "$target_pid" =~ ^[1-9][0-9]*$ ]] || exit 1
  prefix=(nsenter -t "$target_pid" -n)
fi
sleep_pid=""
cleanup() {
  if [[ -n "$sleep_pid" ]]; then
    kill "$sleep_pid" 2>/dev/null || true
    wait "$sleep_pid" 2>/dev/null || true
  fi
  "${prefix[@]}" awg-quick down "$RUNTIME_DIR/awg-exit.conf" || true
  rm -f "$RUNTIME_DIR/awg-exit.conf"
}
trap cleanup EXIT
trap 'exit 0' TERM INT
# Only the network namespace is entered; binaries and resolver remain on the host.
export WG_ENDPOINT_RESOLUTION_RETRIES=0
"${prefix[@]}" timeout 20 awg-quick up "$RUNTIME_DIR/awg-exit.conf"
route_restored=0
while "${prefix[@]}" ip link show awg-exit >/dev/null 2>&1; do
  if [[ -n "$target_pid" ]]; then
    current_pid="$(docker inspect -f '{{.State.Pid}}' "$WG_EASY_CONTAINER" 2>/dev/null || true)"
    [[ "$current_pid" == "$target_pid" ]] || exit 1
  fi
  if [[ "$route_restored" == 0 && -f "$RELAY_ROUTE_FLAG" ]]; then
    if "$AGENT_BIN" relay-reapply; then route_restored=1; fi
  fi
  sleep 2 &
  sleep_pid="$!"
  wait "$sleep_pid" || true
  sleep_pid=""
done
exit 1
