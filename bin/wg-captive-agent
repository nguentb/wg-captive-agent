#!/usr/bin/env bash
set -euo pipefail

CONFIG_FILE="${CONFIG_FILE:-/etc/wg-captive-agent.env}"

if [[ -f "$CONFIG_FILE" ]]; then
  # shellcheck disable=SC1090
  source "$CONFIG_FILE"
fi

WG_INTERFACE="${WG_INTERFACE:-wg0}"
IPSET_NAME="${IPSET_NAME:-wg_expired}"
BLOCKED_DEST_IPSET_NAME="${BLOCKED_DEST_IPSET_NAME:-wg_blocked_dst}"
BLOCKED_DEST_IPS="${BLOCKED_DEST_IPS:-}"
PORTAL_IP="${PORTAL_IP:-}"
PORTAL_URL="${PORTAL_URL:-}"
CAPTIVE_REDIRECT_PORT="${CAPTIVE_REDIRECT_PORT:-51823}"
EXPIRED_FILE="${EXPIRED_FILE:-/etc/wg-captive-expired.txt}"
STATE_DB="${STATE_DB:-/etc/wg-captive-agent.db}"
EXPIRED_URL="${EXPIRED_URL:-}"
API_TOKEN="${API_TOKEN:-}"
SYNC_INTERVAL="${SYNC_INTERVAL:-30}"
BLOCK_DNS="${BLOCK_DNS:-0}"
BLOCK_DOT="${BLOCK_DOT:-0}"
WG_EASY_CONTAINER="${WG_EASY_CONTAINER:-}"
DOCKER_DNS_IP="${DOCKER_DNS_IP:-172.17.0.1}"
RELAY_EXIT_IF="${RELAY_EXIT_IF:-wg-exit}"
RELAY_CLIENT_SUBNET="${RELAY_CLIENT_SUBNET:-10.8.0.0/24}"
RELAY_ROUTE_TABLE="${RELAY_ROUTE_TABLE:-200}"
RELAY_EXIT_CONF="${RELAY_EXIT_CONF:-/etc/wg-captive-relay-exit.conf}"
RELAY_ROUTE_FLAG="${RELAY_ROUTE_FLAG:-/etc/wg-captive-relay.enabled}"
RELAY_PROTOCOL="wireguard"
RELAY_OPENVPN_CONF="${RELAY_OPENVPN_CONF:-/etc/wg-captive-relay-exit.ovpn}"
OPENVPN_RUNTIME_DIR="${OPENVPN_RUNTIME_DIR:-/run/wg-captive-openvpn}"
OPENVPN_STATE_HELPER="${OPENVPN_STATE_HELPER:-/usr/local/lib/wg-captive-agent/openvpn-state.js}"
RELAY_XRAY_CONF="${RELAY_XRAY_CONF:-/etc/wg-captive-relay-exit.json}"
RELAY_WG_EXIT_IF="$RELAY_EXIT_IF"
RELAY_LOCK_FILE="${RELAY_LOCK_FILE:-/run/wg-captive-agent/relay.lock}"
CAPTIVE_MARK="${CAPTIVE_MARK:-0x19}"
CAPTIVE_MARK_PRIORITY="${CAPTIVE_MARK_PRIORITY:-1000}"
RELAY_MARK="${RELAY_MARK:-0x20}"
RELAY_RULE_PRIORITY="${RELAY_RULE_PRIORITY:-2000}"

sqlite_escape() {
  printf "%s" "$1" | sed "s/'/''/g"
}

db_scalar() {
  local sql="$1"
  [[ -f "$STATE_DB" ]] || return 1
  command -v sqlite3 >/dev/null 2>&1 || return 1
  sqlite3 -noheader "$STATE_DB" "$sql" 2>/dev/null | head -n 1
}

db_exec() {
  local sql="$1"
  [[ -f "$STATE_DB" ]] || return 0
  command -v sqlite3 >/dev/null 2>&1 || return 0
  sqlite3 "$STATE_DB" "$sql" >/dev/null 2>&1 || true
}

db_config_value() {
  local key
  key="$(sqlite_escape "$1")"
  db_scalar "SELECT value FROM node_config WHERE key='$key';" || true
}

db_config_text() {
  local key
  key="$(sqlite_escape "$1")"
  [[ -f "$STATE_DB" ]] || return 1
  command -v sqlite3 >/dev/null 2>&1 || return 1
  sqlite3 -noheader "$STATE_DB" "SELECT value FROM node_config WHERE key='$key';" 2>/dev/null || true
}

db_config_exists() {
  local key
  key="$(sqlite_escape "$1")"
  [[ "$(db_scalar "SELECT COUNT(*) FROM node_config WHERE key='$key';" || echo 0)" != "0" ]]
}

db_load_runtime_config() {
  local value
  value="$(db_config_value PORTAL_IP)"; [[ -n "$value" ]] && PORTAL_IP="$value"
  value="$(db_config_value PORTAL_URL)"; [[ -n "$value" ]] && PORTAL_URL="$value"
  value="$(db_config_value BLOCK_DNS)"; [[ -n "$value" ]] && BLOCK_DNS="$value"
  value="$(db_config_value BLOCK_DOT)"; [[ -n "$value" ]] && BLOCK_DOT="$value"
  if db_config_exists BLOCKED_DEST_IPS; then
    BLOCKED_DEST_IPS="$(db_config_text BLOCKED_DEST_IPS)"
  fi
  value="$(db_scalar "SELECT exit_if FROM relay_config WHERE id=1;" || true)"; [[ -n "$value" ]] && RELAY_EXIT_IF="$value"
  value="$(db_scalar "SELECT client_subnet FROM relay_config WHERE id=1;" || true)"; [[ -n "$value" ]] && RELAY_CLIENT_SUBNET="$value"
  value="$(db_scalar "SELECT route_table FROM relay_config WHERE id=1;" || true)"; [[ -n "$value" ]] && RELAY_ROUTE_TABLE="$value"
  value="$(db_scalar "SELECT exit_conf_path FROM relay_config WHERE id=1;" || true)"; [[ -n "$value" ]] && RELAY_EXIT_CONF="$value"
  RELAY_WG_EXIT_IF="$RELAY_EXIT_IF"
  value="$(db_scalar "SELECT protocol FROM relay_config WHERE id=1;" || true)"; [[ -n "$value" ]] && RELAY_PROTOCOL="$value"
  value="$(db_scalar "SELECT openvpn_conf_path FROM relay_config WHERE id=1;" || true)"; [[ -n "$value" ]] && RELAY_OPENVPN_CONF="$value"
  value="$(db_scalar "SELECT xray_conf_path FROM relay_config WHERE id=1;" || true)"; [[ -n "$value" ]] && RELAY_XRAY_CONF="$value"
  if [[ "$RELAY_PROTOCOL" == "openvpn" ]]; then
    RELAY_EXIT_IF="tun-exit"
    RELAY_EXIT_CONF="$RELAY_OPENVPN_CONF"
  elif [[ "$RELAY_PROTOCOL" == "xray" ]]; then
    RELAY_EXIT_IF="xray-exit"
    RELAY_EXIT_CONF="$RELAY_XRAY_CONF"
  fi
}

db_write_relay_conf() {
  [[ -f "$STATE_DB" ]] || return 0
  command -v sqlite3 >/dev/null 2>&1 || return 0
  local content column=exit_conf
  [[ "$RELAY_PROTOCOL" == "openvpn" ]] && column=openvpn_conf
  [[ "$RELAY_PROTOCOL" == "xray" ]] && column=xray_conf
  content="$(sqlite3 -noheader "$STATE_DB" "SELECT $column FROM relay_config WHERE id=1;" 2>/dev/null || true)"
  if [[ -n "$content" && ! -f "$RELAY_EXIT_CONF" ]]; then
    install -d -m 0755 "$(dirname "$RELAY_EXIT_CONF")"
    printf "%s\n" "$content" > "$RELAY_EXIT_CONF"
    chmod 600 "$RELAY_EXIT_CONF" 2>/dev/null || true
  fi
}

db_set_relay_enabled() {
  db_exec "UPDATE relay_config SET enabled=$1, updated_at=CURRENT_TIMESTAMP WHERE id=1;"
}

db_clear_relay_conf() {
  if [[ "$RELAY_PROTOCOL" == "xray" ]]; then
    db_exec "UPDATE relay_config SET enabled=0, xray_conf=NULL, xray_imported_at=NULL, updated_at=CURRENT_TIMESTAMP WHERE id=1;"
  elif [[ "$RELAY_PROTOCOL" == "openvpn" ]]; then
    db_exec "UPDATE relay_config SET enabled=0, openvpn_conf=NULL, openvpn_imported_at=NULL, updated_at=CURRENT_TIMESTAMP WHERE id=1;"
  else
    db_exec "UPDATE relay_config SET enabled=0, exit_conf=NULL, imported_at=NULL, updated_at=CURRENT_TIMESTAMP WHERE id=1;"
  fi
}

db_load_runtime_config
NAT_CHAIN="WG_CAPTIVE_NAT"
FILTER_CHAIN="WG_CAPTIVE_FILTER"
MARK_CHAIN="WG_CAPTIVE_MARK"
RELAY_MARK_CHAIN="WG_RELAY_MARK"
NETNS_PID=""

usage() {
  cat <<'EOF'
Usage: wg-captive-agent [run|sync|cleanup|status|relay-enable|relay-disable|relay-delete-config|relay-on|relay-off|relay-status|relay-tunnel-up|relay-tunnel-down|relay-restart|relay-restore|relay-select wireguard|relay-select openvpn|relay-select xray]

Commands:
  run      Sync expired peers in a loop and keep firewall rules installed.
  sync     Sync expired peers once and install firewall rules.
  cleanup  Remove wg-captive-agent iptables chains and ipset.
  status   Print current ipset and firewall chain status.
  relay-*  Manage relay tunnel and route inside wg-easy container.
EOF
}

die() {
  echo "wg-captive-agent: $*" >&2
  exit 1
}

require_root() {
  [[ "${EUID}" -eq 0 ]] || die "must run as root"
}

require_config() {
  [[ -n "$PORTAL_URL" ]] || die "PORTAL_URL is required; set Portal URL in admin settings"
  [[ -n "$PORTAL_IP" ]] || die "PORTAL_IP is required; save Portal URL in admin first to resolve and store it"
}

resolve_netns() {
  NETNS_PID=""
  if [[ -n "$WG_EASY_CONTAINER" && "$WG_EASY_CONTAINER" != "host" ]]; then
    command -v docker >/dev/null 2>&1 || die "docker is required when WG_EASY_CONTAINER is set"
    command -v nsenter >/dev/null 2>&1 || die "nsenter is required when WG_EASY_CONTAINER is set; install util-linux"
    NETNS_PID="$(docker inspect -f '{{.State.Pid}}' "$WG_EASY_CONTAINER" 2>/dev/null || true)"
    [[ -n "$NETNS_PID" && "$NETNS_PID" != "0" ]] || die "container '$WG_EASY_CONTAINER' is not running"
  fi
}

net_exec() {
  if [[ -n "$NETNS_PID" ]]; then
    nsenter -t "$NETNS_PID" -n "$@"
  else
    "$@"
  fi
}

ipt() {
  net_exec iptables "$@"
}

ips() {
  net_exec ipset "$@"
}

ensure_tools() {
  command -v iptables >/dev/null 2>&1 || die "iptables is required on host"
  command -v ipset >/dev/null 2>&1 || die "ipset is required on host"
  resolve_netns
  net_exec iptables -V >/dev/null 2>&1 || die "iptables cannot run in target network namespace"
  net_exec ipset -V >/dev/null 2>&1 || die "ipset cannot run in target network namespace"
}

iptables_has_rule() {
  local table="$1"
  shift
  ipt -t "$table" -C "$@" >/dev/null 2>&1
}

iptables_append_once() {
  local table="$1"
  shift
  if ! iptables_has_rule "$table" "$@"; then
    ipt -t "$table" -A "$@"
  fi
}

iptables_insert_once() {
  local table="$1"
  shift
  if ! iptables_has_rule "$table" "$@"; then
    ipt -t "$table" -I "$@"
  fi
}

ensure_chain() {
  local table="$1"
  local chain="$2"
  if ! ipt -t "$table" -nL "$chain" >/dev/null 2>&1; then
    ipt -t "$table" -N "$chain"
  fi
}

ensure_firewall() {
  ips create "$IPSET_NAME" hash:ip -exist
  ips create "$BLOCKED_DEST_IPSET_NAME" hash:net -exist

  ensure_chain nat "$NAT_CHAIN"
  ensure_chain filter "$FILTER_CHAIN"
  ensure_chain mangle "$MARK_CHAIN"

  iptables_insert_once filter FORWARD -i "$WG_INTERFACE" -m set --match-set "$BLOCKED_DEST_IPSET_NAME" dst -j REJECT
  iptables_append_once nat PREROUTING -i "$WG_INTERFACE" -m set --match-set "$IPSET_NAME" src -j "$NAT_CHAIN"
  iptables_append_once nat PREROUTING -m set --match-set "$IPSET_NAME" src -j "$NAT_CHAIN"
  iptables_insert_once mangle PREROUTING -m set --match-set "$IPSET_NAME" src -j "$MARK_CHAIN"
  iptables_insert_once filter FORWARD -i "$WG_INTERFACE" -m set --match-set "$IPSET_NAME" src -j "$FILTER_CHAIN"
  iptables_insert_once filter FORWARD -m set --match-set "$IPSET_NAME" src -j "$FILTER_CHAIN"

  ipt -t nat -F "$NAT_CHAIN"
  ipt -t filter -F "$FILTER_CHAIN"
  ipt -t mangle -F "$MARK_CHAIN"

  ipt -t mangle -A "$MARK_CHAIN" -j MARK --set-mark "$CAPTIVE_MARK"
  ipt -t nat -A "$NAT_CHAIN" -p tcp --dport 80 -j REDIRECT --to-ports "$CAPTIVE_REDIRECT_PORT"

  ipt -t filter -A "$FILTER_CHAIN" -d "$PORTAL_IP" -p tcp --dport 80 -j ACCEPT
  ipt -t filter -A "$FILTER_CHAIN" -d "$PORTAL_IP" -p tcp --dport 443 -j ACCEPT

  if [[ "$BLOCK_DNS" == "1" ]]; then
    ipt -t filter -A "$FILTER_CHAIN" -p udp --dport 53 -j REJECT
    ipt -t filter -A "$FILTER_CHAIN" -p tcp --dport 53 -j REJECT
  else
    ipt -t filter -A "$FILTER_CHAIN" -p udp --dport 53 -j ACCEPT
    ipt -t filter -A "$FILTER_CHAIN" -p tcp --dport 53 -j ACCEPT
  fi

  if [[ "$BLOCK_DOT" == "1" ]]; then
    ipt -t filter -A "$FILTER_CHAIN" -p tcp --dport 853 -j REJECT
  else
    ipt -t filter -A "$FILTER_CHAIN" -p tcp --dport 853 -j ACCEPT
  fi

  ipt -t filter -A "$FILTER_CHAIN" -p tcp --dport 443 -j REJECT
  ipt -t filter -A "$FILTER_CHAIN" -j REJECT
}


relay_exec() {
  resolve_netns
  # Use the same host tools/backend as captive, even if the image lacks ipset.
  net_exec sh -ec "$1"
}

relay_wg_exec() {
  if [[ -n "$WG_EASY_CONTAINER" && "$WG_EASY_CONTAINER" != "host" ]]; then
    command -v docker >/dev/null 2>&1 || die "docker is required when WG_EASY_CONTAINER is set"
    docker exec "$WG_EASY_CONTAINER" sh -ec "$1"
  else
    sh -ec "$1"
  fi
}

relay_copy_conf() {
  db_write_relay_conf
  [[ -f "$RELAY_EXIT_CONF" ]] || die "relay config not found: $RELAY_EXIT_CONF"
  install -d -m 0755 /etc/wireguard
  install -m 0600 "$RELAY_EXIT_CONF" "/etc/wireguard/${RELAY_EXIT_IF}.conf"

  if [[ -n "$WG_EASY_CONTAINER" && "$WG_EASY_CONTAINER" != "host" ]]; then
    command -v docker >/dev/null 2>&1 || die "docker is required when WG_EASY_CONTAINER is set"
    docker cp "/etc/wireguard/${RELAY_EXIT_IF}.conf" "$WG_EASY_CONTAINER:/etc/wireguard/${RELAY_EXIT_IF}.conf"
    relay_wg_exec "chmod 600 '/etc/wireguard/${RELAY_EXIT_IF}.conf'"
  fi
}

relay_ensure_forward() {
  sysctl -w net.ipv4.ip_forward=1 >/dev/null
  echo "net.ipv4.ip_forward=1" > /etc/sysctl.d/99-wg-captive-relay.conf
  relay_exec "sysctl -w net.ipv4.ip_forward=1 >/dev/null 2>&1 || true"
}

relay_ensure_captive_mark() {
  relay_exec "
ipset create '$IPSET_NAME' hash:ip -exist
iptables -t mangle -N '$MARK_CHAIN' 2>/dev/null || true
iptables -t mangle -C PREROUTING -m set --match-set '$IPSET_NAME' src -j '$MARK_CHAIN' 2>/dev/null || iptables -t mangle -I PREROUTING -m set --match-set '$IPSET_NAME' src -j '$MARK_CHAIN'
iptables -t mangle -F '$MARK_CHAIN'
iptables -t mangle -A '$MARK_CHAIN' -j MARK --set-mark '$CAPTIVE_MARK'
"
}

relay_ensure_route_mark() {
  relay_exec "
ipset create '$IPSET_NAME' hash:ip -exist
ipset create '$BLOCKED_DEST_IPSET_NAME' hash:net -exist
iptables -t mangle -N '$RELAY_MARK_CHAIN' 2>/dev/null || true
iptables -t mangle -C PREROUTING -s '$RELAY_CLIENT_SUBNET' -j '$RELAY_MARK_CHAIN' 2>/dev/null || iptables -t mangle -A PREROUTING -s '$RELAY_CLIENT_SUBNET' -j '$RELAY_MARK_CHAIN'
iptables -t mangle -F '$RELAY_MARK_CHAIN'
iptables -t mangle -A '$RELAY_MARK_CHAIN' -m set --match-set '$IPSET_NAME' src -j RETURN
iptables -t mangle -A '$RELAY_MARK_CHAIN' -m set --match-set '$BLOCKED_DEST_IPSET_NAME' dst -j RETURN
iptables -t mangle -A '$RELAY_MARK_CHAIN' -p udp --dport 53 -j RETURN
iptables -t mangle -A '$RELAY_MARK_CHAIN' -p tcp --dport 53 -j RETURN
iptables -t mangle -A '$RELAY_MARK_CHAIN' -p tcp --dport 853 -j RETURN
iptables -t mangle -A '$RELAY_MARK_CHAIN' -j MARK --set-mark '$RELAY_MARK'
"
}

relay_tunnel_ready() {
  if [[ "$RELAY_PROTOCOL" == xray ]]; then
    systemctl is-active --quiet wg-captive-xray.service && relay_exec "ip link show xray-exit >/dev/null 2>&1"
  elif [[ "$RELAY_PROTOCOL" == openvpn ]]; then
    systemctl is-active --quiet wg-captive-openvpn.service || return 1
    node "$OPENVPN_STATE_HELPER" ready "$OPENVPN_RUNTIME_DIR/management.sock" || return 1
    relay_exec "ip -4 addr show dev tun-exit 2>/dev/null | grep -q 'inet '"
  else
    relay_exec "ip link show '$RELAY_EXIT_IF' >/dev/null 2>&1"
  fi
}

relay_tunnel_up() {
  if [[ "$RELAY_PROTOCOL" == xray ]]; then
    db_write_relay_conf
    [[ -s "$RELAY_EXIT_CONF" ]] || die "import Xray config first"
    [[ -x /usr/local/lib/wg-captive-agent/xray/xray ]] || die "install Xray first: sudo wg-captive-xray-install"
    systemctl start wg-captive-xray.service
    local attempt
    for attempt in {1..8}; do
      if relay_tunnel_ready; then echo "relay_tunnel: up (Xray TUN ready; test exit separately)"; return; fi
      systemctl is-active --quiet wg-captive-xray.service || break
      sleep 1
    done
    systemctl stop wg-captive-xray.service
    die "Xray TUN did not start; check journalctl -u wg-captive-xray"
  fi
  if [[ "$RELAY_PROTOCOL" == "openvpn" ]]; then
    db_write_relay_conf
    [[ -s "$RELAY_EXIT_CONF" ]] || die "import OpenVPN TCP config first"
    command -v openvpn >/dev/null 2>&1 || die "openvpn is required; install with apt install openvpn"
    if systemctl is-active --quiet wg-captive-openvpn.service && relay_tunnel_ready; then
      echo "relay_tunnel: up"
      return
    fi
    systemctl start wg-captive-openvpn.service
    echo "relay_tunnel: connecting (retries continue in background; check OpenVPN connection state)"
    return
  fi
  relay_copy_conf
  relay_wg_exec "wg-quick down '$RELAY_EXIT_IF' 2>/dev/null || true"
  relay_wg_exec "wg-quick up '$RELAY_EXIT_IF'"
  echo "relay_tunnel: up"
}

relay_tunnel_down() {
  if [[ "$RELAY_PROTOCOL" == xray ]]; then
    systemctl stop wg-captive-xray.service
    echo "relay_tunnel: down"
    return
  fi
  if [[ "$RELAY_PROTOCOL" == "openvpn" ]]; then
    systemctl stop wg-captive-openvpn.service
    echo "relay_tunnel: down"
    return
  fi
  relay_wg_exec "wg-quick down '$RELAY_EXIT_IF' 2>/dev/null || true"
  echo "relay_tunnel: down"
}

relay_route_off() {
  relay_exec "
while ip rule del priority '$CAPTIVE_MARK_PRIORITY' fwmark '$CAPTIVE_MARK' table main 2>/dev/null; do :; done
while ip rule del priority '$RELAY_RULE_PRIORITY' fwmark '$RELAY_MARK' table '$RELAY_ROUTE_TABLE' 2>/dev/null; do :; done
while ip rule del priority '$RELAY_RULE_PRIORITY' from '$RELAY_CLIENT_SUBNET' table '$RELAY_ROUTE_TABLE' 2>/dev/null; do :; done
while ip rule del from '$RELAY_CLIENT_SUBNET' table '$RELAY_ROUTE_TABLE' 2>/dev/null; do :; done
ip route flush table '$RELAY_ROUTE_TABLE' 2>/dev/null || true
while iptables -t nat -D POSTROUTING -s '$RELAY_CLIENT_SUBNET' -o '$RELAY_EXIT_IF' -j MASQUERADE 2>/dev/null; do :; done
while iptables -t mangle -D PREROUTING -s '$RELAY_CLIENT_SUBNET' -j '$RELAY_MARK_CHAIN' 2>/dev/null; do :; done
iptables -t mangle -F '$RELAY_MARK_CHAIN' 2>/dev/null || true
iptables -t mangle -X '$RELAY_MARK_CHAIN' 2>/dev/null || true
while iptables -D FORWARD -j WG_RELAY 2>/dev/null; do :; done
iptables -F WG_RELAY 2>/dev/null || true
iptables -X WG_RELAY 2>/dev/null || true
while ip6tables -D FORWARD -i '$WG_INTERFACE' -m comment --comment wg-captive-xray -j REJECT 2>/dev/null; do :; done
" || true
  rm -f "$RELAY_ROUTE_FLAG"
  db_set_relay_enabled 0
  echo "relay_route: disabled"
}

relay_route_on() {
  local allow_start="${1:-yes}"
  db_write_relay_conf
  [[ -f "$RELAY_EXIT_CONF" ]] || die "import relay exit config before enabling route"
  if [[ "$RELAY_PROTOCOL" == openvpn ]] && ! relay_tunnel_ready; then
    [[ "$allow_start" == yes ]] || return 75
    relay_tunnel_up
    touch "$RELAY_ROUTE_FLAG"
    db_set_relay_enabled 1
    echo "relay_route: pending OpenVPN connection; cancel with relay-off"
    return
  fi
  relay_ensure_forward
  resolve_netns
  # Refresh the same captive and malware guard before routing into userspace.
  if [[ "$RELAY_PROTOCOL" == xray ]]; then
    require_config
    ensure_firewall
    sync_ipset
  fi
  sync_blocked_dest_ipset
  relay_ensure_captive_mark || return 1
  relay_ensure_route_mark || return 1
  if ! relay_exec "ip link show '$RELAY_EXIT_IF' >/dev/null 2>&1"; then
    [[ "$allow_start" == yes ]] || return 1
    relay_tunnel_up
  fi
  if [[ "$RELAY_PROTOCOL" == "openvpn" ]]; then
    relay_exec "ip -4 addr show dev tun-exit | grep -q 'inet '" || die "OpenVPN tunnel has no IPv4 address"
  fi
  relay_route_off >/dev/null 2>&1 || true
  relay_ensure_captive_mark || return 1
  relay_ensure_route_mark || return 1
  if ! relay_exec "
iptables -N WG_RELAY 2>/dev/null || true
iptables -F WG_RELAY
iptables -C FORWARD -j WG_RELAY 2>/dev/null || iptables -A FORWARD -j WG_RELAY
iptables -A WG_RELAY -s '$RELAY_CLIENT_SUBNET' -o '$RELAY_EXIT_IF' -j ACCEPT
ip route add default dev '$RELAY_EXIT_IF' table '$RELAY_ROUTE_TABLE'
ip rule add priority '$RELAY_RULE_PRIORITY' fwmark '$RELAY_MARK' table '$RELAY_ROUTE_TABLE'
if [ '$RELAY_PROTOCOL' != xray ]; then
  iptables -t nat -A POSTROUTING -s '$RELAY_CLIENT_SUBNET' -o '$RELAY_EXIT_IF' -j MASQUERADE
else
  iptables -A WG_RELAY -i '$RELAY_EXIT_IF' -d '$RELAY_CLIENT_SUBNET' -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
fi
"; then
    relay_route_off >/dev/null 2>&1 || true
    echo 'wg-captive-agent: failed to apply relay routing/firewall' >&2
    return 1
  fi
  if [[ "$RELAY_PROTOCOL" == xray ]]; then
    # A disappearing TUN must not fall through to the normal Internet gateway.
    # Current captive/block lists are IPv4-only: reject forwarded IPv6 instead of leaking it.
    if ! relay_exec "
ip route add blackhole default metric 32760 table '$RELAY_ROUTE_TABLE'
sysctl -w net.ipv4.conf.xray-exit.rp_filter=2 >/dev/null
iptables -t mangle -I '$RELAY_MARK_CHAIN' 1 -m set --match-set '$BLOCKED_DEST_IPSET_NAME' dst -j DROP
ip6tables -C FORWARD -i '$WG_INTERFACE' -m comment --comment wg-captive-xray -j REJECT 2>/dev/null || ip6tables -I FORWARD -i '$WG_INTERFACE' -m comment --comment wg-captive-xray -j REJECT
"; then
      relay_route_off >/dev/null 2>&1 || true
      return 1
    fi
  fi
  touch "$RELAY_ROUTE_FLAG"
  db_set_relay_enabled 1
  echo "relay_route: enabled"
}

relay_restart() {
  relay_tunnel_down
  relay_tunnel_up
  if [[ -f "$RELAY_ROUTE_FLAG" ]]; then
    relay_route_on
  fi
}

relay_restore() {
  if [[ -f "$RELAY_ROUTE_FLAG" ]]; then
    relay_tunnel_up
    relay_route_on
  fi
}

relay_reapply() {
  # Re-check intent under relay.lock: a queued reconnect must not undo a manual stop.
  [[ ( "$RELAY_PROTOCOL" == openvpn || "$RELAY_PROTOCOL" == xray ) && -f "$RELAY_ROUTE_FLAG" ]] || return 0
  relay_tunnel_ready || return 75
  relay_route_on no
}

relay_select() {
  local protocol="${1:-}"
  [[ "$protocol" == "wireguard" || "$protocol" == "openvpn" || "$protocol" == xray ]] || die "protocol must be wireguard, openvpn or xray"
  [[ "$protocol" == "$RELAY_PROTOCOL" ]] && return 0
  [[ ! -f "$RELAY_ROUTE_FLAG" ]] || die "stop relay route and tunnel before switching protocol"
  if relay_exec "ip rule show | grep -Eq 'fwmark $RELAY_MARK lookup $RELAY_ROUTE_TABLE|from $RELAY_CLIENT_SUBNET lookup $RELAY_ROUTE_TABLE'"; then
    die "stop relay route before switching protocol"
  fi
  if relay_exec "ip link show '$RELAY_WG_EXIT_IF' >/dev/null 2>&1 || ip link show tun-exit >/dev/null 2>&1 || ip link show xray-exit >/dev/null 2>&1" || systemctl is-active --quiet wg-captive-openvpn.service || systemctl is-active --quiet wg-captive-xray.service; then
    die "stop relay route and tunnel before switching protocol"
  fi
  [[ -f "$STATE_DB" ]] || die "SQLite database is required"
  sqlite3 "$STATE_DB" "UPDATE relay_config SET protocol='$protocol', updated_at=CURRENT_TIMESTAMP WHERE id=1;"
  echo "relay_protocol: $protocol"
}

relay_enable() {
  relay_tunnel_up
  relay_route_on
}

relay_disable() {
  relay_route_off
  relay_tunnel_down
}

relay_delete_config() {
  local tunnel_on=0
  local route_on=0

  if relay_exec "ip link show '$RELAY_EXIT_IF' >/dev/null 2>&1"; then
    tunnel_on=1
  fi
  if [[ "$RELAY_PROTOCOL" == "openvpn" ]] && systemctl is-active --quiet wg-captive-openvpn.service; then
    tunnel_on=1
  fi
  if [[ "$RELAY_PROTOCOL" == xray ]] && systemctl is-active --quiet wg-captive-xray.service; then tunnel_on=1; fi

  if relay_exec "ip rule show | grep -Eq 'fwmark $RELAY_MARK lookup $RELAY_ROUTE_TABLE|from $RELAY_CLIENT_SUBNET lookup $RELAY_ROUTE_TABLE'"; then
    route_on=1
  fi

  if [[ "$tunnel_on" == "1" && "$route_on" == "1" ]]; then
    die "turn off relay tunnel and route before deleting exit config"
  elif [[ "$tunnel_on" == "1" ]]; then
    die "turn off relay tunnel before deleting exit config"
  elif [[ "$route_on" == "1" ]]; then
    die "turn off relay route before deleting exit config"
  fi

  rm -f "$RELAY_EXIT_CONF"
  if [[ "$RELAY_PROTOCOL" == "wireguard" ]]; then
    rm -f "/etc/wireguard/${RELAY_EXIT_IF}.conf"
    relay_wg_exec "rm -f '/etc/wireguard/${RELAY_EXIT_IF}.conf'"
  fi
  db_clear_relay_conf
  echo "relay_config: deleted"
}

relay_status() {
  echo "relay_protocol: $RELAY_PROTOCOL"
  echo "relay_config: $RELAY_EXIT_CONF"
  echo "relay_imported: $([[ -f "$RELAY_EXIT_CONF" ]] && echo yes || echo no)"
  echo "relay_container: ${WG_EASY_CONTAINER:-host}"
  echo "relay_exit_if: $RELAY_EXIT_IF"
  echo "relay_client_subnet: $RELAY_CLIENT_SUBNET"
  echo "relay_route_table: $RELAY_ROUTE_TABLE"
  if [[ "$RELAY_PROTOCOL" == "openvpn" ]]; then
    echo "openvpn_service: $(systemctl is-active wg-captive-openvpn.service 2>/dev/null || true)"
    node "$OPENVPN_STATE_HELPER" state "$OPENVPN_RUNTIME_DIR/management.sock" || true
  elif [[ "$RELAY_PROTOCOL" == xray ]]; then
    echo "xray_service: $(systemctl is-active wg-captive-xray.service 2>/dev/null || true)"
    echo "xray_ready_is_not_exit_health: yes"
    /usr/local/lib/wg-captive-agent/xray/xray version 2>/dev/null | head -n 1 || true
  fi
  echo
  echo "=== Tunnel ==="
  if relay_tunnel_ready; then
    echo "tunnel: UP"
    if [[ "$RELAY_PROTOCOL" == "wireguard" ]]; then
      relay_exec "wg show '$RELAY_EXIT_IF' 2>/dev/null || true"
    else
      relay_exec "ip -4 addr show dev '$RELAY_EXIT_IF'"
    fi
  else
    echo "tunnel: DOWN"
  fi
  echo
  echo "=== Route ==="
  echo "route_requested: $([[ -f "$RELAY_ROUTE_FLAG" ]] && echo yes || echo no)"
  if relay_exec "ip rule show | grep -Eq 'fwmark $RELAY_MARK lookup $RELAY_ROUTE_TABLE|from $RELAY_CLIENT_SUBNET lookup $RELAY_ROUTE_TABLE'"; then
    echo "route: ENABLED"
  else
    echo "route: DISABLED"
  fi
  echo
  echo "=== Policy rules ==="
  relay_exec "ip rule show | grep -E 'fwmark $CAPTIVE_MARK|fwmark $RELAY_MARK|from $RELAY_CLIENT_SUBNET' || true"
  echo
  echo "=== Relay mark chain ==="
  relay_exec "iptables -t mangle -S PREROUTING | grep '$RELAY_MARK_CHAIN' || true"
  relay_exec "iptables -t mangle -S '$RELAY_MARK_CHAIN' 2>/dev/null || true"
  echo
  echo "=== Route table $RELAY_ROUTE_TABLE ==="
  relay_exec "ip route show table '$RELAY_ROUTE_TABLE' 2>/dev/null || true"
  echo
  echo "=== NAT ==="
  relay_exec "iptables -t nat -S POSTROUTING | grep '$RELAY_EXIT_IF' || true"
  echo
  echo "=== Relay chain ==="
  relay_exec "iptables -S WG_RELAY 2>/dev/null || true"
}
extract_ips() {
  grep -Eo '([0-9]{1,3}\.){3}[0-9]{1,3}' | awk '
    function valid(ip, parts, i) {
      split(ip, parts, ".")
      for (i = 1; i <= 4; i++) {
        if (parts[i] < 0 || parts[i] > 255) return 0
      }
      return 1
    }
    valid($1) { print $1 }
  ' | sort -u
}
fetch_expired_ips() {
  if [[ -n "$EXPIRED_URL" ]]; then
    if [[ -n "$API_TOKEN" ]]; then
      curl -fsS -H "Authorization: Bearer ${API_TOKEN}" "$EXPIRED_URL" | extract_ips
    else
      curl -fsS "$EXPIRED_URL" | extract_ips
    fi
    return
  fi

  if [[ -f "$STATE_DB" && -x "$(command -v sqlite3 2>/dev/null || true)" ]]; then
    sqlite3 -noheader "$STATE_DB" "SELECT ip FROM client_state WHERE disabled=1 OR (expired_at IS NOT NULL AND expired_at != '') ORDER BY ip;" 2>/dev/null | extract_ips
    return
  fi

  true
}
sync_ipset() {
  local tmp_set="${IPSET_NAME}_next"

  ips create "$IPSET_NAME" hash:ip -exist
  ips create "$tmp_set" hash:ip -exist
  ips flush "$tmp_set"

  while IFS= read -r ip; do
    [[ -n "$ip" ]] && ips add "$tmp_set" "$ip" -exist
  done < <(fetch_expired_ips)

  ips swap "$tmp_set" "$IPSET_NAME"
  ips destroy "$tmp_set" >/dev/null 2>&1 || true
}

fetch_blocked_dest_ips() {
  printf "%s\n" "$BLOCKED_DEST_IPS" | tr ',;' '\n' | while IFS= read -r line; do
    line="${line%%#*}"
    for item in $line; do
      [[ -n "$item" ]] && printf "%s\n" "$item"
    done
  done
}

sync_blocked_dest_ipset() {
  local tmp_set="${BLOCKED_DEST_IPSET_NAME}_next"

  ips create "$BLOCKED_DEST_IPSET_NAME" hash:net -exist
  ips create "$tmp_set" hash:net -exist
  ips flush "$tmp_set"

  while IFS= read -r ip; do
    if [[ -n "$ip" ]] && ! ips add "$tmp_set" "$ip" -exist 2>/dev/null; then
      echo "wg-captive-agent: skip invalid blocked destination: $ip" >&2
    fi
  done < <(fetch_blocked_dest_ips)

  ips swap "$tmp_set" "$BLOCKED_DEST_IPSET_NAME"
  ips destroy "$tmp_set" >/dev/null 2>&1 || true
}

cleanup() {
  resolve_netns
  ipt -t filter -D FORWARD -i "$WG_INTERFACE" -m set --match-set "$BLOCKED_DEST_IPSET_NAME" dst -j REJECT >/dev/null 2>&1 || true
  ipt -t filter -D FORWARD -m set --match-set "$BLOCKED_DEST_IPSET_NAME" dst -j REJECT >/dev/null 2>&1 || true
  ipt -t nat -D PREROUTING -i "$WG_INTERFACE" -m set --match-set "$IPSET_NAME" src -j "$NAT_CHAIN" >/dev/null 2>&1 || true
  ipt -t nat -D PREROUTING -m set --match-set "$IPSET_NAME" src -j "$NAT_CHAIN" >/dev/null 2>&1 || true
  ipt -t mangle -D PREROUTING -m set --match-set "$IPSET_NAME" src -j "$MARK_CHAIN" >/dev/null 2>&1 || true
  ipt -t filter -D FORWARD -i "$WG_INTERFACE" -m set --match-set "$IPSET_NAME" src -j "$FILTER_CHAIN" >/dev/null 2>&1 || true
  ipt -t filter -D FORWARD -m set --match-set "$IPSET_NAME" src -j "$FILTER_CHAIN" >/dev/null 2>&1 || true

  if ipt -t nat -nL "$NAT_CHAIN" >/dev/null 2>&1; then
    ipt -t nat -F "$NAT_CHAIN"
    ipt -t nat -X "$NAT_CHAIN"
  fi

  if ipt -t filter -nL "$FILTER_CHAIN" >/dev/null 2>&1; then
    ipt -t filter -F "$FILTER_CHAIN"
    ipt -t filter -X "$FILTER_CHAIN"
  fi

  if ipt -t mangle -nL "$MARK_CHAIN" >/dev/null 2>&1; then
    ipt -t mangle -F "$MARK_CHAIN"
    ipt -t mangle -X "$MARK_CHAIN"
  fi

  ips destroy "$IPSET_NAME" >/dev/null 2>&1 || true
  ips destroy "$BLOCKED_DEST_IPSET_NAME" >/dev/null 2>&1 || true
}

status() {
  resolve_netns
  echo "config: $CONFIG_FILE"
  echo "interface: $WG_INTERFACE"
  echo "ipset: $IPSET_NAME"
  echo "blocked_dest_ipset: $BLOCKED_DEST_IPSET_NAME"
  echo "portal_url: ${PORTAL_URL:-}"
  echo "portal_ip: $PORTAL_IP"
  echo "redirect_port: $CAPTIVE_REDIRECT_PORT"
  echo "captive_mark: $CAPTIVE_MARK"
  echo "wg_easy_container: ${WG_EASY_CONTAINER:-host}"
  echo "docker_dns_ip: ${DOCKER_DNS_IP:-disabled}"
  echo "netns_pid: ${NETNS_PID:-host}"
  if net_exec sh -c "ss -ltn 2>/dev/null | grep -q ':${CAPTIVE_REDIRECT_PORT} '"; then
    echo "redirect_listener: listening"
  else
    echo "redirect_listener: missing"
  fi
  echo
  ips list "$IPSET_NAME" 2>/dev/null || true
  echo
  ips list "$BLOCKED_DEST_IPSET_NAME" 2>/dev/null || true
  echo
  ipt -S FORWARD 2>/dev/null | grep "$BLOCKED_DEST_IPSET_NAME" || true
  echo
  ipt -t mangle -S PREROUTING 2>/dev/null | grep "$MARK_CHAIN" || true
  ipt -t mangle -S "$MARK_CHAIN" 2>/dev/null || true
  echo
  echo
  ipt -t nat -S PREROUTING 2>/dev/null | grep "$NAT_CHAIN" || true
  ipt -t nat -S "$NAT_CHAIN" 2>/dev/null || true
  echo
  ipt -S FORWARD 2>/dev/null | grep "$FILTER_CHAIN" || true
  ipt -S "$FILTER_CHAIN" 2>/dev/null || true
}

sync_once() {
  db_load_runtime_config
  require_root
  require_config
  ensure_tools
  ensure_firewall
  sync_ipset
  sync_blocked_dest_ipset
}

run_loop() {
  sync_once
  while true; do
    sleep "$SYNC_INTERVAL"
    sync_once
  done
}

relay_acquire_lock() {
  local command="$1"
  install -d -m 0755 "$(dirname "$RELAY_LOCK_FILE")"
  exec 9>"$RELAY_LOCK_FILE"
  # The supervisor must never queue behind the operation controlling its service.
  if [[ "$command" == relay-reapply ]]; then
    flock -n 9 || return 75
  else
    flock -w 2 9 || die "another relay operation is still running; retry shortly"
  fi
}

main() {
  local command="${1:-run}"
  if [[ "$command" == relay-* && "$command" != "relay-status" ]]; then
    require_root
    relay_acquire_lock "$command" || exit "$?"
    db_load_runtime_config
  fi

  case "$command" in
    run)
      run_loop
      ;;
    sync)
      sync_once
      ;;
    cleanup)
      require_root
      ensure_tools
      cleanup
      ;;
    status)
      status
      ;;
    relay-tunnel-up)
      require_root
      relay_tunnel_up
      ;;
    relay-tunnel-down)
      require_root
      relay_route_off
      relay_tunnel_down
      ;;
    relay-restart)
      require_root
      relay_restart
      ;;
    relay-enable)
      require_root
      relay_enable
      ;;
    relay-disable)
      require_root
      relay_disable
      ;;
    relay-delete-config)
      require_root
      relay_delete_config
      ;;
    relay-on)
      require_root
      relay_route_on
      ;;
    relay-off)
      require_root
      relay_route_off
      ;;
    relay-restore)
      require_root
      relay_restore
      ;;
    relay-status)
      relay_status
      ;;
    relay-select)
      relay_select "${2:-}"
      ;;
    relay-reapply)
      relay_reapply
      ;;
    -h|--help|help)
      usage
      ;;
    *)
      usage
      exit 2
      ;;
  esac
}

main "$@"
