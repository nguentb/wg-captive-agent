#!/usr/bin/env bash
set -euo pipefail

CONFIG_FILE="${CONFIG_FILE:-/etc/wg-captive-agent.env}"
[[ ! -f "$CONFIG_FILE" ]] || source "$CONFIG_FILE"
STATE_DB="${STATE_DB:-/etc/wg-captive-agent.db}"
WG_EASY_CONTAINER="${WG_EASY_CONTAINER:-}"
RELAY_ROUTE_FLAG="${RELAY_ROUTE_FLAG:-/etc/wg-captive-relay.enabled}"
RUNTIME_DIR="${OPENVPN_RUNTIME_DIR:-/run/wg-captive-openvpn}"
AGENT_BIN="${AGENT_BIN:-/usr/local/sbin/wg-captive-agent}"
STATE_HELPER="${OPENVPN_STATE_HELPER:-/usr/local/lib/wg-captive-agent/openvpn-state.js}"
[[ "$(sqlite3 -noheader "$STATE_DB" 'SELECT protocol FROM relay_config WHERE id=1;')" == openvpn ]] || exit 1
conf="$(sqlite3 -noheader "$STATE_DB" 'SELECT openvpn_conf_path FROM relay_config WHERE id=1;')"
[[ -s "$conf" ]] || { echo "OpenVPN config missing" >&2; exit 1; }

# Resolve on the host: its systemd-resolved stub is not reachable in Docker's netns.
read -r directive endpoint port transport < <(grep '^remote ' "$conf")
family=ahosts
[[ "$transport" != tcp4-client ]] || family=ahostsv4
[[ "$transport" != tcp6-client ]] || family=ahostsv6
endpoint_ips="$(getent "$family" "$endpoint" | awk '!seen[$1]++ {print $1}')" || { echo "Cannot resolve OpenVPN endpoint: $endpoint" >&2; exit 1; }
[[ -n "$endpoint_ips" ]] || { echo "Cannot resolve OpenVPN endpoint: $endpoint" >&2; exit 1; }
install -d -m 0700 "$RUNTIME_DIR"
umask 077
awk -v endpoints="$endpoint_ips" -v port="$port" '
  $1=="remote" {
    count=split(endpoints, addresses, "\n")
    for(i=1;i<=count;i++) print "remote",addresses[i],port,(index(addresses[i], ":") ? "tcp6-client" : "tcp4-client")
    next
  }
  {print}
' "$conf" > "$RUNTIME_DIR/client.ovpn"

target_pid=""
prefix=()
if [[ -n "$WG_EASY_CONTAINER" && "$WG_EASY_CONTAINER" != host ]]; then
  target_pid="$(docker inspect -f '{{.State.Pid}}' "$WG_EASY_CONTAINER")"
  [[ "$target_pid" =~ ^[1-9][0-9]*$ ]] || exit 1
  prefix=(nsenter -t "$target_pid" -n)
fi

child_pid=""
sleep_pid=""
stop_child() {
  if [[ -n "$sleep_pid" ]]; then
    kill "$sleep_pid" 2>/dev/null || true
    wait "$sleep_pid" 2>/dev/null || true
  fi
  if [[ -n "$child_pid" ]]; then
    kill "$child_pid" 2>/dev/null || true
    wait "$child_pid" 2>/dev/null || true
  fi
}
trap stop_child EXIT
trap 'exit 0' TERM INT
rm -f "$RUNTIME_DIR/management.sock"
echo "OpenVPN connecting to $endpoint:$port; TCP retries remain active until manually stopped"

"${prefix[@]}" openvpn --config "$RUNTIME_DIR/client.ovpn" \
  --dev tun-exit --dev-type tun --disable-dco --route-nopull --route-noexec \
  --script-security 1 --persist-key --persist-tun --auth-nocache --verb 3 \
  --connect-timeout 10 --connect-retry 1 5 \
  --management "$RUNTIME_DIR/management.sock" unix --management-client-user root &
child_pid="$!"
route_restored=0
while kill -0 "$child_pid" 2>/dev/null; do
  if [[ -n "$target_pid" ]]; then
    current_pid="$(docker inspect -f '{{.State.Pid}}' "$WG_EASY_CONTAINER" 2>/dev/null || true)"
    [[ "$current_pid" == "$target_pid" ]] || exit 1
  fi
  if ! "${prefix[@]}" ip -4 addr show dev tun-exit 2>/dev/null | grep -q 'inet ' || ! node "$STATE_HELPER" ready "$RUNTIME_DIR/management.sock"; then
    route_restored=0
  elif [[ "$route_restored" == 0 ]]; then
    if [[ -f "$RELAY_ROUTE_FLAG" ]]; then
      if "$AGENT_BIN" relay-reapply; then
        route_restored=1
      else
        echo 'Relay route restore deferred; retrying without restarting OpenVPN' >&2
      fi
    else
      route_restored=1
    fi
  fi
  sleep 2 &
  sleep_pid="$!"
  wait "$sleep_pid" || true
  sleep_pid=""
done
exit 1
